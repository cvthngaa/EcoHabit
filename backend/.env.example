# EcoHabit — backend/.env.example
# Copy thành backend/.env rồi điền giá trị thật:
#   cp .env.example .env
# Không commit file .env thật (đã có trong .gitignore).

PORT=3000

# PostgreSQL — DB_PASSWORD phải trùng với POSTGRES_PASSWORD
# trong docker-compose.yml (mặc định cả hai là change-me,
# chỉ dùng cho dev local).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=ecohabit

# Redis (OTP + trạng thái quiz hằng ngày)
REDIS_URL=redis://localhost:6379

# JWT auth
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1d

# Email OTP (Gmail app password) — bắt buộc nếu dùng OTP email
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password

# Cloudinary (upload ảnh) — bắt buộc nếu upload/phân loại ảnh
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI service (FastAPI + YOLOv8)
AI_SERVICE_URL=http://localhost:8000

# Gemini (mẹo sống xanh / nội dung quiz)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite
